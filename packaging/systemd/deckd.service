# deckd — systemd *user* service (generic, non-NixOS).
#
# deckd is a per-user desktop-session daemon: it watches the focused window,
# injects input via /dev/uinput, and talks to the session D-Bus bus, so it must
# run inside your logged-in graphical session — hence a *user* unit
# (systemctl --user), wanted by graphical-session.target, not a system service.
#
# Do not edit this file in place. `just install-service` copies it to
# ~/.config/systemd/user/deckd.service with @PROJECT_DIR@ substituted for your
# checkout path. To customise flags (--bind, --port), edit the installed copy or
# the install recipe.
#
# Prerequisites (one-time): `just setup && just build-client`, plus /dev/uinput
# write access (udev rule + `input` group — see README "uinput permissions"),
# plus the focus watcher for your desktop (GNOME extension / KWin script).

[Unit]
Description=deckd — app-aware touch control surface
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
# Auth is on by default: the shared password is read from (or generated at)
# ~/.config/deckd/password on first start. Localhost-only bind by default;
# add `--bind 0.0.0.0` (or `--bind iface:wlan0`) to expose it on the LAN.
ExecStart=@PROJECT_DIR@/.venv/bin/deckd --layouts-dir @PROJECT_DIR@/layouts --client-dist @PROJECT_DIR@/client/dist
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
